---
import type { Project } from '../../lib/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;

const tagLabels: Record<string, string> = {
  sql: 'SQL',
  ml: 'ML',
  viz: 'Viz',
  python: 'Python',
};
---

<article class="project-card" data-tags={project.tags.join(',')} data-reveal="up">
  <div class="project-card__tags" aria-label="Technology tags">
    {project.tags.map((tag) => <span class={`tag tag--${tag}`}>{tagLabels[tag] ?? tag}</span>)}
  </div>

  <h3 class="project-card__title">{project.title}</h3>
  <p class="project-card__description">{project.description}</p>

  <div class="project-card__links">
    {
      project.githubUrl && (
        <a
          href={project.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="project-card__link"
        >
          GitHub <span class="visually-hidden">(opens in a new tab)</span>
        </a>
      )
    }
    {
      project.linkedinUrl && (
        <a
          href={project.linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="project-card__link"
        >
          LinkedIn <span class="visually-hidden">(opens in a new tab)</span>
        </a>
      )
    }
  </div>

  {project.pdfPresentation && <slot name="pdf-viewer" />}
</article>

<style>
  .project-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    height: 100%;
  }

  .project-card__tags {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    color: white;
  }

  .tag--sql {
    background: var(--color-tag-sql);
  }
  .tag--ml {
    background: var(--color-tag-ml);
  }
  .tag--viz {
    background: var(--color-tag-viz);
  }
  .tag--python {
    background: var(--color-tag-python);
  }

  .project-card__title {
    margin: 0;
    font-size: 1.125rem;
  }

  .project-card__description {
    color: var(--color-text-muted);
    margin: 0;
    flex-grow: 1;
  }

  .project-card__links {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
  }

  .project-card__link {
    font-weight: 600;
    text-decoration: none;
  }

  .project-card__link:hover {
    text-decoration: underline;
  }

  @media (max-width: 480px) {
    .project-card {
      padding: var(--space-sm);
    }
  }
</style>
