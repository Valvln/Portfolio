---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const currentPath = new URL(Astro.request.url).pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />

    <!-- Open Graph (T038) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header class="site-header">
      <nav class="container site-nav" aria-label="Main navigation">
        <a href="/" class="site-nav__brand">Valerio Quaranta - A Data Science Hub</a>
        <ul class="site-nav__links">
          <li><a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>Home</a></li>
          <li>
            <a href="/about" aria-current={currentPath === '/about' ? 'page' : undefined}>About</a>
          </li>
        </ul>
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>&copy; {new Date().getFullYear()} — Junior Data Scientist Portfolio</p>
      </div>
    </footer>

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--color-primary);
        color: var(--color-primary-contrast);
        padding: var(--space-xs) var(--space-sm);
        z-index: 100;
      }
      .skip-link:focus {
        left: var(--space-sm);
        top: var(--space-sm);
      }

      .site-header {
        border-bottom: 1px solid var(--color-border);
        background: var(--color-bg);
        position: sticky;
        top: 0;
        z-index: 10;
      }

      /* `wrap` non è cosmetico: il brand è passato da 21 a 37 caratteri e a
         320px il contenitore lascia ~272px utili, che il solo brand riempie
         già. Senza andare a capo, brand e collegamenti si comprimerebbero a
         vicenda. Nessun troncamento: il testo dell'intestazione va letto per
         intero (plan.md, decisione R5). */
      .site-nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-xs) var(--space-sm);
        padding-block: var(--space-sm);
      }

      .site-nav__brand {
        font-size: clamp(0.9rem, 3.2vw, 1rem);
        font-weight: 700;
        text-decoration: none;
        color: var(--color-text);
      }

      .site-nav__links {
        list-style: none;
        display: flex;
        gap: var(--space-md);
        margin: 0;
        padding: 0;
      }

      .site-nav__links a {
        text-decoration: none;
        color: var(--color-text);
        font-weight: 500;
        padding: var(--space-xs);
      }

      .site-nav__links a[aria-current='page'] {
        color: var(--color-primary);
      }

      .site-footer {
        border-top: 1px solid var(--color-border);
        margin-top: var(--space-xl);
        padding-block: var(--space-lg);
        color: var(--color-text-muted);
        font-size: 0.875rem;
      }
    </style>
  </body>
</html>
