---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutSection from '../components/about/AboutSection.astro';
import { getAbout } from '../lib/about';

const about = await getAbout();
---

<BaseLayout
  title="About — Valerio Quaranta, Junior Data Scientist"
  description="Professional background, technical skills and contact details of Valerio Quaranta, junior data scientist."
>
  <AboutSection about={about} />
</BaseLayout>
